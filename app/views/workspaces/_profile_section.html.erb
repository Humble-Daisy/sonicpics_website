<%# locals: (workspace:)
    Workspace Profile section — name, logo, and primary color in one form.
    Posts to workspaces#update (gated by Workspaces::ProfilePolicy). %>
<section class="space-y-4" aria-labelledby="settings-identity-heading">
  <h2 id="settings-identity-heading" class="text-lg font-semibold text-text-heading">
    <%= t("workspaces.settings.edit.sections.identity_title") %>
  </h2>
  <%= form_with model: workspace, url: workspace_path(workspace), method: :patch,
        class: "space-y-6" do |form| %>
    <%= form.error_summary %>

    <%= form.text_field :name,
          label: t("workspaces.edit.name_label"),
          required: true %>

    <%= form.submit t("workspaces.settings.edit.sections.identity_submit") %>
  <% end %>

  <%# The logo section is a SIBLING of the name form, never inside it. The
      identity picker renders its own <form>; the HTML parser ignores a nested
      <form> start tag but honours its </form>, which closes the OUTER form and
      orphans every control after it — the submit button included, so the name
      silently could not be saved. The picker posts on its own. %>
  <div class="space-y-4">
    <div class="space-y-2">
      <p class="block text-sm font-medium text-text-body">
        <%= t("workspaces.brandings.edit.logo_label") %>
      </p>
      <div class="flex items-center gap-4" data-controller="modal">
        <button data-action="click->modal#open"
                type="button"
                class="shrink-0 rounded-full focus-ring cursor-pointer group">
          <%= render "workspaces/logo_branding", workspace: workspace %>
        </button>

        <%= render "shared/modal", title: t("identity_picker.choose_workspace_logo"), size: :lg do %>
          <%= render "shared/identity_picker",
                model: workspace,
                form_url: workspace_path(workspace),
                remove_url: workspace_logo_path(workspace),
                hub_url: workspace_logo_path(workspace),
                hub_title: t("identity_picker.choose_workspace_logo"),
                crop_title: t("identity_picker.adjust_workspace_logo") %>
        <% end %>
      </div>
    </div>
  </div>
</section>
