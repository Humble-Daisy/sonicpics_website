<% content_for(:title) { @resource.title } %>
<div class="max-w-4xl mx-auto px-4 py-16">
  <div class="flex items-start justify-between">
    <div>
      <h1 class="text-3xl font-bold text-text-heading">
        <%= @resource.title %>
      </h1>
      <div class="mt-2 flex items-center gap-3">
        <% if @resource.draft? %>
          <%= ui :badge, t("workspaces.projects.resources.index.draft"),
                variant: :soft, tone: :neutral %>
        <% else %>
          <%= ui :badge, t("workspaces.projects.resources.index.published"),
                variant: :soft, tone: :success %>
        <% end %>
        <span class="text-sm text-text-muted">
          <%= t("workspaces.projects.resources.show.created_by", name: @resource.created_by.full_name) %>
          &middot; <%# erblint:disable HardCodedString - presentational glyph, not language (#498) %>
          <%= l @resource.created_at.to_date %>
        </span>
      </div>
    </div>
    <div class="flex items-center gap-3">
      <% if policy(@resource).destroy? %>
        <div data-controller="modal" class="inline">
          <button type="button"
                  data-action="click->modal#open"
                  class="btn-touch-target btn-text btn-text-danger text-sm">
            <%= t("workspaces.projects.resources.show.delete") %>
          </button>
          <%= render "shared/confirm_dialog",
                title: t("workspaces.projects.resources.destroy.title"),
                message: t("workspaces.projects.resources.destroy.confirm"),
                confirm_text: t("workspaces.projects.resources.destroy.confirm_action"),
                confirm_url: workspace_project_resource_path(@workspace, @project, @resource),
                confirm_method: :delete,
                variant: :danger %>
        </div>
      <% end %>
      <% if policy(@resource).update? %>
        <%= link_to t("workspaces.projects.resources.show.edit"),
              edit_workspace_project_resource_path(@workspace, @project, @resource),
              class: "btn-primary" %>
      <% end %>
    </div>
  </div>

  <div class="mt-8 prose max-w-none">
    <%= render "workspaces/projects/resources/types/#{@resource.resourceable_type.underscore}", resource: @resource %>
  </div>

  <div class="mt-8">
    <%= link_to t("workspaces.projects.resources.show.back"),
          workspace_project_resources_path(@workspace, @project),
          class: "text-interactive hover:underline
                  focus-ring rounded" %>
  </div>
</div>
