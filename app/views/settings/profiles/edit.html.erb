<% content_for(:title) { t("settings.profiles.edit.title") } %>
<div class="page-container">
  <%= render "shared/settings_page_header",
        title: t("settings.pages.profile_personal.h1"),
        description: t("settings.pages.profile_personal.description") %>

  <div class="flex items-center gap-6 mt-8 mb-8"
       data-controller="modal">

    <button data-action="click->modal#open"
            type="button"
            class="shrink-0 rounded-full focus-ring cursor-pointer group"
            aria-label="<%= t('settings.avatars.edit.change_aria_label', initials: @user.identity.initials) %>">
      <span id="user_avatar_profile" class="block relative">
        <%= avatar_for(@user, size: :xl) %>
        <span class="absolute inset-0 rounded-full bg-black/0 group-hover:bg-black/20
                     transition-colors flex items-center justify-center">
          <%= icon(:pencil, size: :md,
                class: "text-white opacity-0 group-hover:opacity-100 transition-opacity drop-shadow-md") %>
        </span>
      </span>
    </button>

    <div>
      <p class="text-lg font-semibold text-text-heading"><%= @user.full_name %></p>
      <button data-action="click->modal#open"
              type="button"
              class="text-sm text-interactive underline hover:no-underline mt-1
                     min-h-input min-w-[var(--form-input-height)]
                     focus-ring rounded">
        <%= t("settings.avatars.edit.change") %>
      </button>
    </div>

    <%= render "shared/modal", title: t("identity_picker.choose_profile_picture"), size: :lg do %>
      <%= render "shared/identity_picker",
            model: @user,
            form_url: settings_avatar_path,
            remove_url: settings_avatar_path,
            hub_url: settings_avatar_path,
            hub_title: t("identity_picker.choose_profile_picture"),
            crop_title: t("identity_picker.adjust_profile_picture") %>
    <% end %>
  </div>

  <%= form_with model: @user, url: settings_profile_path, method: :patch, class: "mt-8 space-y-6" do |form| %>
    <%= form.error_summary %>

    <%= form.text_field :first_name,
          label: t("settings.profiles.edit.first_name_label"),
          required: true,
          autocomplete: "given-name" %>

    <%= form.text_field :last_name,
          label: t("settings.profiles.edit.last_name_label"),
          required: true,
          autocomplete: "family-name" %>

    <%= form.email_field :email_address,
          label: t("settings.profiles.edit.email_label"),
          help: t("settings.profiles.edit.email_help"),
          required: true,
          autocomplete: "email" %>

    <% if @user.pending_email.present? %>
      <%# UI::Alert (#731): the component supplies the tinted chip, icon and
          role=status; the cancel action rides the description slot. %>
      <%= render UI::AlertComponent.new(tone: :info) do |alert| %>
        <% alert.with_alert_description do %>
          <%= t("settings.profiles.edit.pending_email_notice", email: @user.pending_email) %>
          <p class="mt-2">
            <%= link_to t("settings.profiles.edit.cancel_email_change"),
                  settings_email_confirmation_path,
                  data: { turbo_method: :delete },
                  class: "text-sm text-interactive underline hover:no-underline" %>
          </p>
        <% end %>
      <% end %>
    <% end %>

    <%= form.submit t("settings.profiles.edit.submit"), class: "btn-primary w-full" %>
  <% end %>
</div>
