<% content_for(:title) { t("pages.home.hero.title") } %>

<%# Photo first, as on the original: each slide carries its own caption and
    App Store badge on an opaque band along the photo's foot (axe wants an
    opaque plate under any control laid over media). Slide one's caption is the page's h1;
    inactive slides only slide out of view, so it stays in the outline. The
    caption's right padding clears the carousel's pause button. %>
<section class="max-w-6xl mx-auto sm:px-6 lg:px-8 sm:pt-6" aria-label="<%= t("pages.home.carousel.label") %>">
  <%= ui(:carousel, label: t("pages.home.carousel.label"), autoplay: 8000, class: "sm:rounded-xl") do |carousel| %>
    <% [
         { image: "banner_museum.jpg", alt: t("pages.home.carousel.museum_alt"), tag: :h1,
           title: t("pages.home.hero.title"), subtitle: t("pages.home.hero.subtitle") },
         { image: "banner_boygrass.jpg", alt: t("pages.home.carousel.grass_alt"), tag: :p,
           title: t("pages.home.carousel.grass_title"), subtitle: t("pages.home.carousel.grass_subtitle") }
       ].each do |slide| %>
      <% carousel.with_slide do %>
        <div class="relative">
          <%= image_tag "sonicpics/#{slide[:image]}",
                alt: slide[:alt],
                class: "w-full h-80 sm:h-[32rem] object-cover" %>
          <div class="absolute inset-x-0 bottom-0 bg-neutral-900 text-white
                      px-4 sm:px-8 pt-4 pb-16 sm:pb-6 sm:pr-20
                      flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
            <div class="max-w-2xl">
              <%= content_tag slide[:tag], slide[:title],
                    class: "text-2xl sm:text-4xl font-bold tracking-tight" %>
              <p class="mt-2 sm:text-lg text-neutral-100"><%= slide[:subtitle] %></p>
            </div>
            <%= render "pages/app_store_badge" %>
          </div>
        </div>
      <% end %>
    <% end %>
  <% end %>
</section>

<%= render "shared/section", bg: "bg-surface" do %>
  <div class="grid sm:grid-cols-3 gap-6">
    <% %w[features sample_uses classroom].each do |highlight| %>
      <%= link_to "##{highlight}",
            class: "p-6 bg-surface-raised rounded-lg border border-border
                    hover:border-interactive focus-ring block" do %>
        <h2 class="text-lg font-semibold text-text-heading">
          <%= t("pages.home.highlights.#{highlight}.title") %>
        </h2>
        <p class="mt-2 text-text-muted">
          <%= t("pages.home.highlights.#{highlight}.description") %>
        </p>
        <span class="mt-4 inline-flex text-interactive">
          <%= t("pages.home.highlights.view") %>
        </span>
      <% end %>
    <% end %>
  </div>
<% end %>

<div id="features" class="scroll-mt-24">
<%= render "shared/section",
      title: t("pages.home.features.title"),
      subtitle: t("pages.home.features.subtitle"),
      bg: "bg-surface-raised" do %>
  <div class="grid sm:grid-cols-2 gap-8">
    <% {
         "slideshows" => "sonicpics/features/plus.png",
         "images" => "sonicpics/features/camera.png",
         "narration" => "sonicpics/features/record.png",
         "interface" => "sonicpics/features/easy.png",
         "playback" => "sonicpics/features/clapboard.png",
         "sharing" => "sonicpics/features/cloud.png",
         "video_out" => "sonicpics/features/create.png",
         "universal" => "sonicpics/features/universal.png"
       }.each do |feature, icon| %>
      <div class="flex gap-4">
        <%= image_tag icon, alt: "", class: "size-11 shrink-0" %>
        <div>
          <h3 class="text-lg font-semibold text-text-heading">
            <%= t("pages.home.features.#{feature}.title") %>
          </h3>
          <p class="mt-2 text-text-muted">
            <%= t("pages.home.features.#{feature}.description") %>
          </p>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
</div>

<div id="classroom" class="scroll-mt-24">
<%= render "shared/section", bg: "bg-surface" do %>
  <div class="grid lg:grid-cols-2 gap-10 items-center">
    <div>
      <h2 class="text-3xl font-bold text-text-heading">
        <%= t("pages.home.classroom.title") %>
      </h2>
      <% t("pages.home.classroom.paragraphs").each do |paragraph| %>
        <p class="mt-4 text-lg text-text-muted"><%= paragraph %></p>
      <% end %>
    </div>
    <%= image_tag "sonicpics/SonicPicsCascadingPhotos.png",
          alt: t("pages.home.classroom.image_alt"),
          class: "w-full h-auto" %>
  </div>
<% end %>
</div>

<div id="sample_uses" class="scroll-mt-24">
<%= render "shared/section",
      title: t("pages.sample_uses.title"),
      subtitle: t("pages.sample_uses.subtitle"),
      bg: "bg-surface-raised" do %>
  <div class="space-y-12">
    <div class="max-w-md mx-auto">
      <%= ui(:carousel, label: t("pages.home.quotes.label"), autoplay: 8000, class: "rounded-xl") do |carousel| %>
        <% carousel.with_slide do %>
          <%= image_tag "sonicpics/quotes/Underpriced.png",
                alt: t("pages.home.quotes.underpriced_alt"),
                class: "mx-auto max-h-64 w-auto bg-white rounded-lg" %>
        <% end %>
        <% carousel.with_slide do %>
          <%= image_tag "sonicpics/quotes/MoreUses.png",
                alt: t("pages.home.quotes.more_uses_alt"),
                class: "mx-auto max-h-64 w-auto bg-white rounded-lg" %>
        <% end %>
        <% carousel.with_slide do %>
          <%= image_tag "sonicpics/quotes/ZillionUsersWhite.png",
                alt: t("pages.home.quotes.zillion_alt"),
                class: "mx-auto max-h-64 w-auto bg-white rounded-lg" %>
        <% end %>
      <% end %>
    </div>
    <%= render "pages/sample_uses" %>
  </div>
<% end %>
</div>

<section class="bg-pink-900">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12
              flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
    <div>
      <h2 class="text-3xl font-bold text-white"><%= t("pages.home.cta.title") %></h2>
      <p class="mt-2 text-lg text-pink-50"><%= t("pages.home.cta.subtitle") %></p>
    </div>
    <%= render "pages/app_store_badge" %>
  </div>
</section>
