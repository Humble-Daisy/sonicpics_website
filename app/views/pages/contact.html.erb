<% content_for(:title) { t("pages.contact.title") } %>

<%= render "shared/hero",
      title: t("pages.contact.hero.title"),
      subtitle: t("pages.contact.hero.subtitle") %>

<%= render "shared/section",
      title: t("pages.contact.methods.title"),
      bg: "bg-surface" do %>
  <div class="grid sm:grid-cols-2 gap-6 max-w-2xl mx-auto">
    <%= mail_to t("pages.contact.methods.email.address"),
          subject: t("pages.support.email_subject"),
          class: "p-6 bg-surface-raised rounded-lg border border-border
                  hover:border-interactive focus-ring block" do %>
      <h3 class="text-lg font-semibold text-text-heading">
        <%= t("pages.contact.methods.email.title") %>
      </h3>
      <p class="mt-2 text-text-muted">
        <%= t("pages.contact.methods.email.description",
              address: t("pages.contact.methods.email.address")) %>
      </p>
    <% end %>
    <%= link_to t("pages.contact.methods.company.url"),
          target: "_blank", rel: "noopener noreferrer",
          class: "p-6 bg-surface-raised rounded-lg border border-border
                  hover:border-interactive focus-ring block" do %>
      <h3 class="text-lg font-semibold text-text-heading">
        <%= t("pages.contact.methods.company.title") %>
      </h3>
      <p class="mt-2 text-text-muted">
        <%= t("pages.contact.methods.company.description") %>
      </p>
      <span class="sr-only"><%= t("pages.external.new_tab") %></span>
    <% end %>
  </div>
<% end %>

<%= render "shared/section",
      title: t("pages.contact.community.title"),
      bg: "bg-surface-raised" do %>
  <div class="grid sm:grid-cols-3 gap-6 max-w-3xl mx-auto">
    <% %w[twitter facebook linkedin].each do |channel| %>
      <%= link_to t("pages.contact.community.#{channel}.url"),
            target: "_blank", rel: "noopener noreferrer",
            class: "p-6 bg-surface-overlay rounded-lg border border-border
                    hover:border-interactive focus-ring block" do %>
        <h3 class="text-lg font-semibold text-text-heading">
          <%= t("pages.contact.community.#{channel}.title") %>
        </h3>
        <p class="mt-2 text-text-muted">
          <%= t("pages.contact.community.#{channel}.description") %>
        </p>
        <span class="sr-only"><%= t("pages.external.new_tab") %></span>
      <% end %>
    <% end %>
  </div>
<% end %>
