#!/usr/bin/env ruby
# frozen_string_literal: true

# Runs the full RSpec suite across all cores (parallel_tests) with two
# integrity gates on top of pass/fail:
#
#   1. Example-count parity — a --dry-run enumeration fixes the expected
#      example count; the per-worker counts (spec/support/
#      parallel_example_count.rb) must sum to exactly that. Catches a
#      splitter dropping or duplicating spec files.
#      The enumeration costs ~50s per run: that is the price of "green means
#      everything ran," paid deliberately (#496, panel-reviewed 2026-08-14).
#      It exists because the splitter really has dropped files; do not move
#      it to a schedule or hide it behind a cache — a parity check that runs
#      sometimes is a parity check you trust never.
#   2. Merged coverage floor — workers skip the minimum (each sees ~1/N of
#      the suite); SimpleCov.collate enforces it on the merged result.
#
# Worker count: PARALLEL_TEST_PROCESSORS or the machine's core count.
# Plain `bundle exec rspec` remains the single-process reference path.
#
# CI sharding (#495): with CI_SHARD_INDEX + CI_SHARD_TOTAL set, this runner
# takes only its shard's slice of the spec files — greedy-packed by the same
# recorded runtimes the in-shard worker split uses (file size as fallback) —
# and SKIPS the merged-coverage floor (each shard sees ~1/N of the suite;
# the test CI job collates every shard's resultset and enforces
# the floor there). Example-count parity still runs PER SHARD against the
# shard's own enumeration, and each shard records its file list to
# tmp/shard_files.txt so CI can assert the union of shards equals the full
# spec set — the shard splitter gets the same distrust as the worker
# splitter. Locally (no shard env) behavior is unchanged.

require_relative "../config/boot"
require_relative "../spec/coverage_config"
require "json"
require "fileutils"
require "pathname"

class ParallelRspecRunner
  COUNTS_DIR = "tmp/parallel_example_counts"
  DRY_RUN_JSON = "tmp/parallel_rspec_dry_run.json"
  RUNTIME_LOG = "tmp/parallel_runtime_rspec.log"
  SHARD_FILES_LIST = "tmp/shard_files.txt"

  # Deterministic greedy bin-pack: heaviest file first into the lightest
  # shard. Weight = recorded runtime when present, file size otherwise (the
  # same fallback the worker split uses). Ties broken by path so the split
  # is stable across machines and runs.
  def self.shard_files(files, runtimes:, count:, index:)
    weight = lambda do |f|
      runtimes[f] || (File.exist?(f) ? File.size(f) / 10_000.0 : 0.0)
    end
    bins = Array.new(count) { { files: [], total: 0.0 } }
    files.sort.sort_by { |f| [ -weight.call(f), f ] }.each do |f|
      bin = bins.min_by.with_index { |b, i| [ b[:total], i ] }
      bin[:files] << f
      bin[:total] += weight.call(f)
    end
    bins.fetch(index)[:files].sort
  end

  def initialize(counts_dir: COUNTS_DIR, dry_run_json: DRY_RUN_JSON)
    @counts_dir = Pathname.new(counts_dir)
    @dry_run_json = Pathname.new(dry_run_json)
  end

  def run
    reset_artifacts
    select_shard!
    enumerate!
    puts "==> Expecting #{expected_count} examples#{shard? ? " (shard #{shard_index + 1}/#{shard_total})" : ''}"
    prepare_databases!
    build_assets!
    run_suite!
    verify_count!
    puts "==> Example-count parity verified (#{executed_count}/#{expected_count})"
    if shard?
      puts "==> Shard #{shard_index + 1}/#{shard_total}: coverage floor deferred to the test job"
    else
      enforce_coverage!
    end
  end

  def shard?
    !ENV["CI_SHARD_TOTAL"].to_s.empty?
  end

  def shard_index = Integer(ENV.fetch("CI_SHARD_INDEX"))
  def shard_total = Integer(ENV.fetch("CI_SHARD_TOTAL"))

  def expected_count
    JSON.parse(@dry_run_json.read).fetch("summary").fetch("example_count")
  end

  def executed_count
    Pathname.glob(@counts_dir.join("*.count")).sum { |f| Integer(f.read) }
  end

  def verify_count!
    return if executed_count == expected_count

    per_worker = Pathname.glob(@counts_dir.join("*.count"))
      .sort.map { |f| "worker #{f.basename('.count')}: #{f.read}" }.join(", ")
    abort(<<~MSG)
      parallel-rspec: example-count mismatch — expected #{expected_count}, ran #{executed_count}.
      The parallel splitter dropped or duplicated at least one spec file.
      Per-worker counts: #{per_worker.empty? ? '(none recorded)' : per_worker}
    MSG
  end

  # Built once here, serially, before any worker forks. tailwindcss-rails
  # enhances `assets:clobber` with `tailwindcss:clobber`, so bin/setup leaves
  # no stylesheet behind, and the gem's rebuild hook fires on `test:prepare` —
  # the Minitest path RSpec never takes. Without this, a post-setup run fails
  # every axe-contrast and layout-dependent system spec at once, naming
  # neither Tailwind nor assets.
  def build_assets!
    puts "==> Building Tailwind CSS (system specs render unstyled without it)"
    system("bundle", "exec", "rails", "tailwindcss:build") ||
      abort("parallel-rspec: tailwindcss:build failed (see output above)")
  end

  # db:setup, not db:seed alone: a seed into a stale schema is purged when the
  # worker boots (maintain_test_schema!), leaving the table empty — see PR body.
  def prepare_databases!
    puts "==> Reloading the schema and seeds into every worker database"
    system("bundle", "exec", "rake", "parallel:setup") ||
      abort("parallel-rspec: parallel:setup failed (see output above)")
  end

  private

  def reset_artifacts
    FileUtils.rm_rf(@counts_dir)
    FileUtils.rm_rf("coverage") # stale worker resultsets would pollute the merge
    FileUtils.rm_f(@dry_run_json)
  end

  # nil = the whole suite (local path); an array = this shard's file slice.
  def shard_file_list
    @shard_file_list
  end

  def select_shard!
    return unless shard?

    all_files = Dir["spec/**/*_spec.rb"].sort
    runtimes = read_runtimes
    @shard_file_list = self.class.shard_files(
      all_files, runtimes: runtimes, count: shard_total, index: shard_index
    )
    # Recorded so CI's test job can assert the union of every
    # shard's list equals the full spec set — a shard splitter that drops a
    # file must fail as loudly as a worker splitter that does (#495).
    File.write(SHARD_FILES_LIST, @shard_file_list.join("\n") + "\n")
    puts "==> Shard #{shard_index + 1}/#{shard_total}: #{@shard_file_list.size} of #{all_files.size} spec files " \
         "(#{runtimes.empty? ? 'file-size split (no runtime log)' : 'runtime-balanced split'})"
  end

  # The shard split MUST be computed from an input identical on every shard:
  # the suite rewrites RUNTIME_LOG with only its own files' timings, so a
  # shard that reads the live log after another shard ran (or a cache restore
  # that raced a concurrent run) computes a DIFFERENT partition — overlapping
  # shards and silent holes (caught locally building this: shards overlapped
  # on 108 files). CI's split_seed job snapshots one log and every shard
  # reads that frozen copy via SHARD_RUNTIME_SOURCE.
  def runtime_source
    ENV["SHARD_RUNTIME_SOURCE"].to_s.empty? ? RUNTIME_LOG : ENV["SHARD_RUNTIME_SOURCE"]
  end

  def read_runtimes
    return {} unless File.exist?(runtime_source)

    File.readlines(runtime_source).filter_map do |line|
      path, seconds = line.strip.split(":", 2)
      [ path, Float(seconds) ] if path && seconds
    rescue ArgumentError
      nil
    end.to_h
  end

  def enumerate!
    puts "==> Enumerating expected example count (rspec --dry-run)"
    FileUtils.mkdir_p(@dry_run_json.dirname)
    system(
      { "SKIP_COVERAGE" => "1" },
      "bundle", "exec", "rspec", "--dry-run",
      "--format", "json", "--out", @dry_run_json.to_s,
      *Array(shard_file_list)
    ) || abort("parallel-rspec: dry-run enumeration failed")
  end

  def run_suite!
    puts "==> Running the suite with parallel_rspec"
    # -f progress passed explicitly, so the two support formatters no longer
    # each have to restore the implicit default the other suppressed via a
    # `config.formatters.empty?` side-effect (#496). parallel_tests reads its
    # worker summaries from this formatter, so it must stay present.
    targets = shard_file_list || [ "spec" ]

    # Every worker runs the SAME ordering seed, and the seed is always printed.
    #
    # Before this, `config.order = :random` (spec/spec_helper.rb) meant each of
    # the 32 processes in a CI run picked its own seed and recorded it nowhere,
    # so no flake here was ever replayable — every diagnosis was a story rather
    # than a reproduction, and the standing remedy became "raise a timeout"
    # (panel audit, 2026-08-26). `SEED=<n> bin/parallel-rspec` now replays a
    # failing interleaving. The CROSS-SHARD split is deterministic from the
    # frozen split_seed snapshot; the in-shard worker grouping normally rides
    # the LIVE runtime log, which every run rewrites — so an explicit SEED
    # also pins grouping to file size (deterministic from the working tree
    # alone) and the runtime logger stands down (spec/support/
    # parallel_runtime_log.rb), keeping a diagnostic run from overwriting the
    # balance data (#867). A replay reproduces ordering and grouping — not
    # necessarily Faker-derived data from a run under a different mapping.
    # Plain Ruby: this script runs outside Rails, so no ActiveSupport here.
    replaying = !ENV["SEED"].to_s.empty?
    seed = replaying ? ENV["SEED"] : rand(100_000).to_s
    puts "==> Ordering seed: #{seed}  (replay with SEED=#{seed} bin/parallel-rspec"          " — reproduces ordering, not necessarily data)"

    grouping = replaying ? [ "--group-by", "filesize" ] : []
    system("bundle", "exec", "parallel_rspec", *targets, *grouping,
           "--test-options", "-f progress --seed #{seed}") ||
      abort("parallel-rspec: spec failures (see output above; SEED=#{seed})")
  end

  def enforce_coverage!
    puts "==> Merging coverage and enforcing the #{CoverageConfig::MINIMUM}% floor"
    # Shell out so SimpleCov.collate's at_exit hook runs in a throwaway
    # process (loading this file elsewhere must never register it).
    collate = <<~RUBY
      require "simplecov"
      SimpleCov.collate Dir["coverage/.resultset.json"], "rails" do
        enable_coverage :branch
        merge_timeout #{CoverageConfig::MERGE_TIMEOUT}
        minimum_coverage #{CoverageConfig::MINIMUM}
      end
    RUBY
    system("bundle", "exec", "ruby", "-e", collate) ||
      abort("parallel-rspec: merged coverage below #{CoverageConfig::MINIMUM}% (see report above)")
  end
end

ParallelRspecRunner.new.run if $PROGRAM_NAME == __FILE__
