# See https://git-scm.com/docs/gitattributes for more about git attribute files.

# Mark the database schema as having been generated.
db/schema.rb linguist-generated

# Mark any vendored files as having been vendored.
vendor/* linguist-vendored
config/credentials/*.yml.enc diff=rails_credentials
config/credentials.yml.enc diff=rails_credentials

# Entries go in changelog.d/ files; union still keeps both sides of a release-section fix.
CHANGELOG.md merge=union

# Fork-owned paths — downstream forks rewrite these wholesale; upstream
# freezes them. With the driver active in a fork (bin/setup runs
# `git config merge.ours.driver true` when an upstream remote exists),
# a sync where BOTH sides changed one of these files resolves to the
# fork's version. Files the fork never touched still take upstream's
# changes — the driver only runs on two-sided changes. See /docs/developer/forking.
# Inert in this repo (driver deliberately unset upstream).
app/views/pages/** merge=ours
app/controllers/pages_controller.rb merge=ours
config/locales/en/pages.en.yml merge=ours
config/locales/en/brand.en.yml merge=ours
config/routes/app.rb merge=ours
.rubocop/app.yml merge=ours
config/markdowndocs_categories.local.yml merge=ours
app/assets/tailwind/tokens/_brand.css merge=ours
README.md merge=ours
# The brand mark and the icon set: artwork, replaced wholesale by a fork. The
# PNG/ICO files can't three-way merge at all, so ours is the only honest answer.
app/views/shared/_site_mark.html.erb merge=ours
public/icon.svg merge=ours
public/icon.png merge=ours
public/icon-192.png merge=ours
public/icon-512.png merge=ours
public/apple-touch-icon.png merge=ours
public/favicon.ico merge=ours
# The fork's names for the product's nouns. Holds nothing upstream will ever
# change (defaults live in config/vocabulary.yml), so freezing it is safe.
config/vocabulary.local.yml merge=ours
# A fork's own operations pages, listed for the operations nav. Empty upstream, so freezing it is safe.
app/helpers/operations/fork_nav_helper.rb merge=ours
# Where a fork registers its own project tools. The registry API that reads this
# file is template-owned, so an API change still breaks a frozen fork initializer
# loudly at boot — the same posture as config/routes/app.rb.
config/initializers/project_tools.rb merge=ours
# Fork provenance (bin/fork). Upstream ships no .fork.yml today, so merges are
# clean — this is insurance for the day it ships an example and every fork would
# otherwise conflict on its own provenance. bin/fork itself stays template-owned:
# forks shouldn't edit it, and freezing it would pin them to the version they
# forked at, bugs included.
.fork.yml merge=ours
